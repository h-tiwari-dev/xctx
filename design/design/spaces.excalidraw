      "isDeleted": false,
      "boundElements": null,
      "updated": 1795456904184,
      "link": null,
      "locked": false,
      "text": "The repo's mise.toml sets tools and variables. The space adds its own file, so two spaces on one repo never share a port or a secret.",
      "originalText": "The repo's mise.toml sets tools and variables. The space adds its own file, so two spaces on one repo never share a port or a secret.",
      "fontSize": 15,
