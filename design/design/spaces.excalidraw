    },
    {
      "id": "text_192",
      "type": "text",
      "x": 1800,
      "y": 1960,
      "width": 973.5000000000001,
      "height": 18.75,
      "angle": 0,
      "strokeColor": "#e7e2d6",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": "frame_145",
      "roundness": null,
      "seed": 1608702975,
      "version": 1,
      "versionNonce": 453329113,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1795456904184,
      "link": null,
      "locked": false,
      "text": "Every plugin brings three things: a pane you can see, tools agents can call, and events that can start or stop a loop.",
      "originalText": "Every plugin brings three things: a pane you can see, tools agents can call, and events that can start or stop a loop.",
      "fontSize": 15,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true
    },
    {
      "id": "text_193",
      "type": "text",
      "x": 1800,
      "y": 1990,
      "width": 858.0000000000001,
      "height": 18.75,
      "angle": 0,
      "strokeColor": "#938e82",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": "frame_145",
      "roundness": null,
      "seed": 2035401041,
      "version": 1,
      "versionNonce": 1364751026,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1795456904184,
      "link": null,
      "locked": false,
      "text": "The harness is what lets a space look like a browser one minute and a Postman-style API client the next.",
      "originalText": "The harness is what lets a space look like a browser one minute and a Postman-style API client the next.",
      "fontSize": 15,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true
    },
    {
      "id": "text_194",
      "type": "text",
      "x": 1800,
      "y": 2020,
      "width": 693,
      "height": 18.75,
      "angle": 0,
      "strokeColor": "#938e82",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": "frame_145",
      "roundness": null,
      "seed": 2120045740,
      "version": 1,
      "versionNonce": 1032701477,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1795456904184,
      "link": null,
      "locked": false,
      "text": "Agents can use plugins with nobody watching, so a space can keep working on its own.",
      "originalText": "Agents can use plugins with nobody watching, so a space can keep working on its own.",
      "fontSize": 15,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true
    },
    {
      "id": "frame_195",
      "type": "frame",
      "x": 0,
      "y": 2280,
      "width": 1600,
      "height": 1000,
      "angle": 0,
      "strokeColor": "#e7e2d6",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 981243123,
      "version": 1,
      "versionNonce": 1254792090,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1795456904184,
      "link": null,
      "locked": false,
      "name": "4 Plugins compose a space"
    },
    {
      "id": "text_196",
      "type": "text",
      "x": 40,
      "y": 2304,
      "width": 729.3000000000001,
      "height": 32.5,
      "angle": 0,
      "strokeColor": "#e7e2d6",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": "frame_195",
      "roundness": null,
      "seed": 1516642645,
      "version": 1,
      "versionNonce": 1191471535,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1795456904184,
      "link": null,
      "locked": false,
      "text": "A space is agents + plugins + a loop + shared state",
      "originalText": "A space is agents + plugins + a loop + shared state",
      "fontSize": 26,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true
    },
    {
      "id": "text_197",
      "type": "text",
      "x": 40,
      "y": 2346,
      "width": 849.7500000000001,
      "height": 18.75,
      "angle": 0,
      "strokeColor": "#938e82",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": "frame_195",
      "roundness": null,
      "seed": 1113272510,
      "version": 1,
      "versionNonce": 2024774651,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1795456904184,
      "link": null,
      "locked": false,
      "text": "The parent composes it from the task, and recomposes it when the task changes. You can change any part.",
      "originalText": "The parent composes it from the task, and recomposes it when the task changes. You can change any part.",
      "fontSize": 15,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true
    },
    {
      "id": "rectangle_198",
      "type": "rectangle",
      "x": 60,
      "y": 2410,
      "width": 620,
      "height": 400,
      "angle": 0,
      "strokeColor": "#b3a6e0",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
