      "name": "5 A mise environment per space"
    },
    {
      "id": "text_257",
      "type": "text",
      "x": 1780,
      "y": 2304,
      "width": 672.1,
      "height": 32.5,
      "angle": 0,
      "strokeColor": "#e7e2d6",
      "backgroundColor": "transparent",
