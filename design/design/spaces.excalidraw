      "seed": 2070651185,
      "version": 1,
      "versionNonce": 512274942,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1795456904184,
      "link": null,
      "locked": false,
      "text": "Each space runs inside its own mise environment",
      "originalText": "Each space runs inside its own mise environment",
      "fontSize": 26,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true
    },
    {
      "id": "text_258",
